
<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pharmacy Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen flex flex-col">

    <!-- Top Navigation Bar -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <span class="bg-emerald-600 text-white p-2 rounded-xl text-lg font-bold shadow-md"><i class="fa-solid fa-plus"></i></span>
                <span class="text-xl font-bold tracking-tight text-emerald-800" data-i18n="sysName">Pharmacy Pro</span>
            </div>
            
            <nav class="hidden md:flex space-x-1 lg:space-x-4">
                <button onclick="switchTab('home')" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition text-emerald-700 bg-emerald-50 active-tab" id="btn-home"><i class="fa-solid fa-house mr-1"></i> <span data-i18n="navHome">Home</span></button>
                <button onclick="switchTab('inventory')" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition text-gray-600 hover:bg-gray-100" id="btn-inventory"><i class="fa-solid fa-boxes-stacked mr-1"></i> <span data-i18n="navInventory">Inventory</span></button>
                <button onclick="switchTab('suppliers')" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition text-gray-600 hover:bg-gray-100" id="btn-suppliers"><i class="fa-solid fa-truck-field mr-1"></i> <span data-i18n="navSuppliers">Suppliers</span></button>
                <button onclick="switchTab('sales')" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition text-gray-600 hover:bg-gray-100" id="btn-sales"><i class="fa-solid fa-cash-register mr-1"></i> <span data-i18n="navSales">Sales</span></button>
                <button onclick="switchTab('debts')" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition text-gray-600 hover:bg-gray-100" id="btn-debts"><i class="fa-solid fa-file-invoice-dollar mr-1"></i> <span data-i18n="navDebts">Debts</span></button>
                <button onclick="switchTab('customers')" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition text-gray-600 hover:bg-gray-100" id="btn-customers"><i class="fa-solid fa-users mr-1"></i> <span data-i18n="navCustomers">Customers</span></button>
                <button onclick="switchTab('daily')" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition text-gray-600 hover:bg-gray-100" id="btn-daily"><i class="fa-solid fa-chart-line mr-1"></i> <span data-i18n="navDaily">Daily Report</span></button>
            </nav>

            <div class="flex items-center gap-3">
                <!-- Language Selector -->
                <select id="language-select" onchange="changeLanguage(this.value)" class="bg-gray-100 border border-gray-200 text-gray-700 text-sm rounded-xl px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
                    <option value="en">English</option>
                    <option value="ar">العربية</option>
                    <option value="fr">Français</option>
                </select>

                <div class="text-sm font-semibold bg-gray-100 px-3 py-1.5 rounded-lg text-gray-700 hidden sm:block" id="current-date-display">
                    20/08/2026
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-6">

        <!-- HOME TAB -->
        <section id="tab-home" class="tab-content space-y-6">
            <h1 class="text-2xl font-bold text-gray-900" data-i18n="dashTitle">Dashboard Overview</h1>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500" data-i18n="statSales">Today's Sales</p>
                        <h3 class="text-2xl font-bold text-gray-900 mt-1" id="stat-sales-today">0</h3>
                        <span class="text-xs text-emerald-600 font-medium" data-i18n="transactions">Transactions</span>
                    </div>
                    <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl shadow-inner">
                        <i class="fa-solid fa-bag-shopping"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500" data-i18n="statLow">Low Stock Alert</p>
                        <h3 class="text-2xl font-bold text-gray-900 mt-1" id="stat-low-stock">0</h3>
                        <span class="text-xs text-amber-600 font-medium" data-i18n="statLowSub">Medicines &le; 10</span>
                    </div>
                    <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-xl shadow-inner">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500" data-i18n="statExpiry">Near Expiry</p>
                        <h3 class="text-2xl font-bold text-gray-900 mt-1" id="stat-near-expiry">0</h3>
                        <span class="text-xs text-rose-600 font-medium" data-i18n="statExpirySub">Check dates</span>
                    </div>
                    <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center text-xl shadow-inner">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500" data-i18n="statDebts">Due Debts</p>
                        <h3 class="text-2xl font-bold text-gray-900 mt-1" id="stat-due-debts">0</h3>
                        <span class="text-xs text-indigo-600 font-medium" data-i18n="statDebtsSub">Customers</span>
                    </div>
                    <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl shadow-inner">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                </div>
            </div>
        </section>

        <!-- INVENTORY TAB -->
        <section id="tab-inventory" class="tab-content hidden space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <h1 class="text-2xl font-bold text-gray-900" data-i18n="invTitle">Inventory Management</h1>
                <button onclick="openModal('medicine-modal')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold shadow-sm transition flex items-center gap-2">
                    <i class="fa-solid fa-plus"></i> <span data-i18n="addMedicineBtn">Add Medicine</span>
                </button>
            </div>

            <!-- Filters & Search -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-2 overflow-x-auto w-full md:w-auto pb-2 md:pb-0">
                    <button onclick="filterInventory('all')" class="inv-filter px-3 py-1.5 rounded-lg text-sm font-medium bg-emerald-50 text-emerald-700 border border-emerald-200" id="filter-all" data-i18n="filterAll">All</button>
                    <button onclick="filterInventory('low')" class="inv-filter px-3 py-1.5 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100" id="filter-low" data-i18n="filterLow">Low Stock</button>
                    <button onclick="filterInventory('expiry')" class="inv-filter px-3 py-1.5 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100" id="filter-expiry" data-i18n="filterExpiry">Near Expiry</button>
                </div>
                <div class="relative w-full md:w-72">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="search-medicine" oninput="renderInventory()" data-i18n-placeholder="searchPlaceholder" placeholder="Search medicine name..." class="w-full pl-10 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
            </div>

            <!-- Inventory Table -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse" id="inv-table-dir">
                        <thead>
                            <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider border-b border-gray-100">
                                <th class="p-4" data-i18n="thName">Name</th>
                                <th class="p-4" data-i18n="thType">Type</th>
                                <th class="p-4" data-i18n="thQty">Quantity</th>
                                <th class="p-4" data-i18n="thAlert">Low Alert</th>
                                <th class="p-4" data-i18n="thBuy">Buy Price</th>
                                <th class="p-4" data-i18n="thSell">Sell Price</th>
                                <th class="p-4" data-i18n="thProfit">Profit</th>
                                <th class="p-4" data-i18n="thExpiry">Expiry Date</th>
                                <th class="p-4" data-i18n="thOrigin">Origin / Lab</th>
                                <th class="p-4 text-center" data-i18n="thActions">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="inventory-table-body" class="divide-y divide-gray-100 text-sm"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- SUPPLIERS TAB -->
        <section id="tab-suppliers" class="tab-content hidden space-y-6">
            <div class="flex justify-between items-center">
                <h1 class="text-2xl font-bold text-gray-900" data-i18n="supTitle">Suppliers Management</h1>
                <button onclick="openModal('supplier-modal')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold shadow-sm transition flex items-center gap-2">
                    <i class="fa-solid fa-plus"></i> <span data-i18n="addSupplierBtn">Add Supply Order</span>
                </button>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider border-b border-gray-100">
                            <th class="p-4" data-i18n="thSupId">ID</th>
                            <th class="p-4" data-i18n="thSupDate">Date / Time</th>
                            <th class="p-4" data-i18n="thSupAmount">Amount</th>
                            <th class="p-4" data-i18n="thSupDesc">Description</th>
                        </tr>
                    </thead>
                    <tbody id="suppliers-table-body" class="divide-y divide-gray-100 text-sm"></tbody>
                </table>
            </div>
        </section>

        <!-- SALES TAB -->
        <section id="tab-sales" class="tab-content hidden grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 space-y-4">
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" id="sales-search-input" oninput="renderSalesSearch()" data-i18n-placeholder="salesSearchPlaceholder" placeholder="Quick search medicine to sell..." class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    </div>
                    <div id="sales-search-results" class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-60 overflow-y-auto"></div>
                </div>

                <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                    <h3 class="text-lg font-bold mb-3" data-i18n="bestSellersTitle">Best Sellers</h3>
                    <div id="best-sellers-list" class="flex flex-wrap gap-2"></div>
                </div>
            </div>

            <!-- Invoice Panel -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between space-y-4">
                <div>
                    <div class="flex justify-between items-center border-b pb-3 mb-3">
                        <h3 class="font-bold text-lg text-gray-900" data-i18n="currentInvoiceTitle">Current Invoice</h3>
                        <span class="text-xs font-semibold px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg" id="invoice-number-display">PH/00001</span>
                    </div>

                    <!-- Payment Type toggle -->
                    <div class="flex gap-2 mb-3">
                        <button onclick="setPaymentMode('paid')" id="mode-paid-btn" class="flex-1 py-2 text-xs font-semibold rounded-lg bg-emerald-600 text-white transition" data-i18n="modePaid">Paid</button>
                        <button onclick="setPaymentMode('debt')" id="mode-debt-btn" class="flex-1 py-2 text-xs font-semibold rounded-lg bg-gray-100 text-gray-600 transition" data-i18n="modeDebt">Debt</button>
                    </div>

                    <div id="customer-select-container" class="hidden mb-3">
                        <label class="block text-xs font-medium text-gray-500 mb-1" data-i18n="selectCustomerLabel">Select Customer</label>
                        <select id="invoice-customer-select" class="w-full p-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none"></select>
                    </div>

                    <div id="invoice-items-list" class="space-y-2 max-h-56 overflow-y-auto mb-3 divide-y divide-gray-50"></div>
                </div>

                <div class="border-t pt-4 space-y-3">
                    <div>
                        <span class="text-xs font-medium text-gray-500" data-i18n="paymentMethodLabel">Payment Method</span>
                        <div class="grid grid-cols-2 gap-2 mt-1">
                            <button onclick="setPaymentMethod('Cash')" id="pm-cash" class="py-1.5 text-xs font-medium border rounded-lg bg-emerald-50 border-emerald-200 text-emerald-700" data-i18n="methodCash">Cash</button>
                            <button onclick="setPaymentMethod('Bankly')" id="pm-bankly" class="py-1.5 text-xs font-medium border rounded-lg bg-gray-50 border-gray-200 text-gray-600" data-i18n="methodBank">Bank App</button>
                        </div>
                    </div>
                    <div class="flex justify-between items-center text-lg font-bold">
                        <span data-i18n="totalLabel">Total:</span>
                        <span class="text-emerald-600" id="invoice-total-display">0 MRU</span>
                    </div>
                    <button onclick="completeSale()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 rounded-xl text-sm font-semibold shadow-sm transition" data-i18n="completeBtn">
                        Complete Transaction
                    </button>
                </div>
            </div>
        </section>

        <!-- DEBTS TAB -->
        <section id="tab-debts" class="tab-content hidden space-y-6">
            <h1 class="text-2xl font-bold text-gray-900" data-i18n="debtsTitle">Debts Tracking</h1>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 space-y-4">
                    <h3 class="font-bold text-gray-800 flex items-center gap-2"><i class="fa-solid fa-triangle-exclamation text-amber-500"></i> <span data-i18n="dueDebtsTitle">Due Debts (Time to collect)</span></h3>
                    <div id="due-debts-list" class="space-y-2 divide-y divide-gray-50"></div>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 space-y-4">
                    <h3 class="font-bold text-gray-800 flex items-center gap-2"><i class="fa-solid fa-building-columns text-emerald-600"></i> <span data-i18n="pharmacyLiabilitiesTitle">Pharmacy Liabilities (Due to suppliers)</span></h3>
                    <div class="p-4 bg-gray-50 rounded-xl flex justify-between items-center">
                        <span class="text-sm font-medium text-gray-600" data-i18n="totalLiabilitiesLabel">Total Liabilities</span>
                        <span class="text-lg font-bold text-rose-600" id="pharmacy-liabilities-display">0 MRU</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- CUSTOMERS TAB -->
        <section id="tab-customers" class="tab-content hidden space-y-6">
            <div class="flex justify-between items-center">
                <h1 class="text-2xl font-bold text-gray-900" data-i18n="custTitle">Customers Management</h1>
                <button onclick="openModal('customer-modal')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold shadow-sm transition flex items-center gap-2">
                    <i class="fa-solid fa-user-plus"></i> <span data-i18n="addCustBtn">Add Customer</span>
                </button>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider border-b border-gray-100">
                            <th class="p-4" data-i18n="thCustName">Name</th>
                            <th class="p-4" data-i18n="thCustPhone">Phone</th>
                            <th class="p-4" data-i18n="thCustDebt">Current Debt</th>
                            <th class="p-4" data-i18n="thCustStatus">Status</th>
                        </tr>
                    </thead>
                    <tbody id="customers-table-body" class="divide-y divide-gray-100 text-sm"></tbody>
                </table>
            </div>
        </section>

        <!-- DAILY REPORT TAB -->
        <section id="tab-daily" class="tab-content hidden space-y-6">
            <div class="flex justify-between items-center">
                <h1 class="text-2xl font-bold text-gray-900" data-i18n="dailyTitle">Daily Summary Report</h1>
                <button onclick="downloadPDFReport()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold shadow-sm transition flex items-center gap-2">
                    <i class="fa-solid fa-download"></i> <span data-i18n="downloadPdfBtn">Download PDF</span>
                </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                <div class="bg-white p-4 rounded-2xl border border-gray-100 text-center">
                    <span class="text-xs text-gray-500 font-medium" data-i18n="repRev">Total Revenue</span>
                    <h4 class="text-xl font-bold text-emerald-600 mt-1" id="daily-total-rev">0 MRU</h4>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-gray-100 text-center">
                    <span class="text-xs text-gray-500 font-medium" data-i18n="repCash">Cash Sales</span>
                    <h4 class="text-xl font-bold text-gray-800 mt-1" id="daily-cash">0 MRU</h4>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-gray-100 text-center">
                    <span class="text-xs text-gray-500 font-medium" data-i18n="repBank">Bank Apps</span>
                    <h4 class="text-xl font-bold text-gray-800 mt-1" id="daily-bank">0 MRU</h4>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-gray-100 text-center">
                    <span class="text-xs text-gray-500 font-medium" data-i18n="repDebt">Credit/Debts</span>
                    <h4 class="text-xl font-bold text-amber-600 mt-1" id="daily-debt">0 MRU</h4>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider border-b border-gray-100">
                            <th class="p-4" data-i18n="thRepInv">Invoice #</th>
                            <th class="p-4" data-i18n="thRepTime">Time</th>
                            <th class="p-4" data-i18n="thRepMethod">Method</th>
                            <th class="p-4" data-i18n="thRepTotal">Total</th>
                            <th class="p-4" data-i18n="thRepStatus">Status</th>
                            <th class="p-4 text-center" data-i18n="thRepAction">Action</th>
                        </tr>
                    </thead>
                    <tbody id="daily-invoices-body" class="divide-y divide-gray-100 text-sm"></tbody>
                </table>
            </div>
        </section>

    </main>

    <!-- MODALS -->

    <!-- Add Medicine Modal -->
    <div id="medicine-modal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 space-y-4 shadow-xl">
            <h3 class="text-lg font-bold text-gray-900" data-i18n="modalMedTitle">Add New Medicine</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1" data-i18n="mName">Medicine Name</label>
                    <input type="text" id="med-name" class="w-full p-2.5 bg-gray-50 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1" data-i18n="mType">Type</label>
                    <select id="med-type" class="w-full p-2.5 bg-gray-50 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
                        <option value="tablets">tablets</option>
                        <option value="syrup">syrup</option>
                        <option value="capsules">capsules</option>
                        <option value="box">box</option>
                        <option value="vials">vials</option>
                        <option value="other">other</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1" data-i18n="mQty">Quantity</label>
                    <input type="number" id="med-qty" class="w-full p-2.5 bg-gray-50 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1" data-i18n="mAlert">Low Stock Alert Limit</label>
                    <input type="number" id="med-alert" value="10" class="w-full p-2.5 bg-gray-50 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1" data-i18n="mBuy">Buy Price (MRU)</label>
                    <input type="number" id="med-buy" class="w-full p-2.5 bg-gray-50 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1" data-i18n="mSell">Sell Price (MRU)</label>
                    <input type="number" id="med-sell" class="w-full p-2.5 bg-gray-50 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1" data-i18n="mExpiry">Expiry Date</label>
                    <input type="date" id="med-expiry" class="w-full p-2.5 bg-gray-50 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
