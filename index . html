            activeTab: 'home',
            filterType: 'all'
        };

        function init() {
            renderAll();
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            
            document.querySelectorAll('.nav-btn').forEach(el => {
                el.classList.remove('text-emerald-700', 'bg-emerald-50');
                el.classList.add('text-gray-600', 'hover:bg-gray-100');
            });
            const activeBtn = document.getElementById(`btn-${tabId}`);
            if(activeBtn) {
                activeBtn.classList.remove('text-gray-600', 'hover:bg-gray-100');
                activeBtn.classList.add('text-emerald-700', 'bg-emerald-50');
            }
            state.activeTab = tabId;
            renderAll();
        }

        function openModal(modalId) { document.getElementById(modalId).classList.remove('hidden'); }
        function closeModal(modalId) { document.getElementById(modalId).classList.add('hidden'); }

        function saveMedicine() {
            const name = document.getElementById('med-name').value;
            const type = document.getElementById('med-type').value;
            const qty = parseInt(document.getElementById('med-qty').value) || 0;
            const alert = parseInt(document.getElementById('med-alert').value) || 10;
            const buy = parseFloat(document.getElementById('med-buy').value) || 0;
            const sell = parseFloat(document.getElementById('med-sell').value) || 0;
            const expiry = document.getElementById('med-expiry').value;
            const origin = document.getElementById('med-origin').value;

            if(!name) return;
            state.medicines.push({ name, type, qty, alert, buy, sell, expiry, origin });
            closeModal('medicine-modal');
            renderAll();
        }

        function saveSupplier() {
            const amount = parseFloat(document.getElementById('sup-amount').value) || 0;
            const desc = document.getElementById('sup-desc').value;
            const id = '#' + (state.suppliers.length + 1);
            const now = new Date().toLocaleString();
            state.suppliers.unshift({ id, date: now, amount, desc });
            closeModal('supplier-modal');
            renderAll();
        }

        function saveCustomer() {
            const name = document.getElementById('cust-name').value;
            const phone = document.getElementById('cust-phone').value;
            if(!name) return;
            state.customers.push({ name, phone, debt: 0 });
            closeModal('customer-modal');
            renderAll();
        }

        function filterInventory(type) {
            state.filterType = type;
            document.querySelectorAll('.inv-filter').forEach(btn => {
                btn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border', 'border-emerald-200');
                btn.classList.add('bg-gray-50', 'text-gray-600');
            });
            document.getElementById(`filter-${type}`).classList.add('bg-emerald-50', 'text-emerald-700', 'border', 'border-emerald-200');
            renderInventory();
        }

        function renderInventory() {
            const tbody = document.getElementById('inventory-table-body');
            const search = document.getElementById('search-medicine').value.toLowerCase();
            tbody.innerHTML = '';

            let filtered = state.medicines.filter(m => m.name.toLowerCase().includes(search));
            if(state.filterType === 'low') {
                filtered = filtered.filter(m => m.qty <= m.alert);
            } else if(state.filterType === 'expiry') {
                filtered = filtered.filter(m => new Date(m.expiry) < new Date(Date.now() + 30*24*60*60*1000));
            }

            if(filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="10" class="p-4 text-center text-gray-400">No medicines found</td></tr>`;
                return;
            }

            filtered.forEach((m, idx) => {
                const profit = m.sell - m.buy;
                const lowClass = m.qty <= m.alert ? 'text-rose-600 font-bold bg-rose-50 px-2 py-0.5 rounded' : '';
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50">
                        <td class="p-4 font-medium">${m.name}</td>
                        <td class="p-4"><span class="px-2 py-1 bg-gray-100 rounded-lg text-xs">${m.type}</span></td>
                        <td class="p-4"><span class="${lowClass}">${m.qty}</span></td>
                        <td class="p-4">${m.alert}</td>
                        <td class="p-4">${m.buy} MRU</td>
                        <td class="p-4">${m.sell} MRU</td>
                        <td class="p-4 text-emerald-600 font-medium">${profit} MRU</td>
                        <td class="p-4">${m.expiry}</td>
                        <td class="p-4">${m.origin || '-'}</td>
                        <td class="p-4 text-center">
                            <button onclick="deleteMedicine(${idx})" class="text-rose-500 hover:text-rose-700 p-1"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>
                `;
            });
        }

        function deleteMedicine(index) {
            state.medicines.splice(index, 1);
            renderAll();
        }

        function renderSuppliers() {
            const tbody = document.getElementById('suppliers-table-body');
            tbody.innerHTML = '';
            state.suppliers.forEach(s => {
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50">
                        <td class="p-4 font-semibold">${s.id}</td>
                        <td class="p-4 text-gray-500">${s.date}</td>
                        <td class="p-4 font-bold text-emerald-600">${s.amount} MRU</td>
                        <td class="p-4">${s.desc}</td>
                    </tr>
                `;
            });
        }

        function renderSalesSearch() {
            const query = document.getElementById('sales-search-input').value.toLowerCase();
            const container = document.getElementById('sales-search-results');
            container.innerHTML = '';
            if(!query) return;

            const matches = state.medicines.filter(m => m.name.toLowerCase().includes(query));
            matches.forEach(m => {
                container.innerHTML += `
                    <div onclick="addToCart('${m.name}')" class="p-3 bg-gray-50 hover:bg-emerald-50 border border-gray-100 rounded-xl cursor-pointer flex justify-between items-center transition">
                        <div>
                            <h4 class="font-semibold text-sm">${m.name}</h4>
                            <span class="text-xs text-gray-500">Stock: ${m.qty} | Price: ${m.sell} MRU</span>
                        </div>
                        <i class="fa-solid fa-plus text-emerald-600"></i>
                    </div>
                `;
            });
        }

        function addToCart(name) {
            const med = state.medicines.find(m => m.name === name);
            if(!med || med.qty <= 0) return;
            const existing = state.currentCart.find(item => item.name === name);
            if(existing) {
                if(existing.qty < med.qty) existing.qty++;
            } else {
                state.currentCart.push({ name, price: med.sell, qty: 1 });
            }
            renderCart();
        }

        function renderCart() {
            const list = document.getElementById('invoice-items-list');
            list.innerHTML = '';
            let total = 0;

            state.currentCart.forEach((item, idx) => {
                total += item.price * item.qty;
                list.innerHTML += `
                    <div class="flex justify-between items-center py-2">
                        <div>
                            <h4 class="font-medium text-sm">${item.name}</h4>
                            <span class="text-xs text-gray-500">${item.price} MRU × ${item.qty}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-sm">${item.price * item.qty} MRU</span>
                            <button onclick="removeFromCart(${idx})" class="text-rose-500 text-xs"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                    </div>
                `;
            });

            document.getElementById('invoice-total-display').innerText = total + ' MRU';
            document.getElementById('invoice-number-display').innerText = 'PH/' + String(state.invoices.length + 1).padStart(5, '0');
        }

        function removeFromCart(idx) {
            state.currentCart.splice(idx, 1);
            renderCart();
        }

        function setPaymentMode(mode) {
            state.paymentMode = mode;
            const paidBtn = document.getElementById('mode-paid-btn');
            const debtBtn = document.getElementById('mode-debt-btn');
            const custContainer = document.getElementById('customer-select-container');

            if(mode === 'paid') {
                paidBtn.className = "flex-1 py-2 text-xs font-semibold rounded-lg bg-emerald-600 text-white transition";
                debtBtn.className = "flex-1 py-2 text-xs font-semibold rounded-lg bg-gray-100 text-gray-600 transition";
                custContainer.classList.add('hidden');
            } else {
                debtBtn.className = "flex-1 py-2 text-xs font-semibold rounded-lg bg-amber-600 text-white transition";
                paidBtn.className = "flex-1 py-2 text-xs font-semibold rounded-lg bg-gray-100 text-gray-600 transition";
                custContainer.classList.remove('hidden');
                populateCustomerSelect();
            }
        }

        function setPaymentMethod(method) {
            state.paymentMethod = method;
            document.getElementById('pm-cash').className = method === 'Cash' ? "py-1.5 text-xs font-medium border rounded-lg bg-emerald-50 border-emerald-200 text-emerald-700" : "py-1.5 text-xs font-medium border rounded-lg bg-gray-50 border-gray-200 text-gray-600";
            document.getElementById('pm-bankly').className = method === 'Bankly' ? "py-1.5 text-xs font-medium border rounded-lg bg-emerald-50 border-emerald-200 text-emerald-700" : "py-1.5 text-xs font-medium border rounded-lg bg-gray-50 border-gray-200 text-gray-600";
        }

        function populateCustomerSelect() {
            const select = document.getElementById('invoice-customer-select');
            select.innerHTML = '';
            state.customers.forEach(c => {
                select.innerHTML += `<option value="${c.name}">${c.name} (${c.phone})</option>`;
            });
        }

        function completeSale() {
            if(state.currentCart.length === 0) return;
            let total = state.currentCart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            state.currentCart.forEach(item => {
                let med = state.medicines.find(m => m.name === item.name);
                if(med) med.qty -= item.qty;
            });

            const invoice = {
                id: 'PH/' + String(state.invoices.length + 1).padStart(5, '0'),
                time: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
                date: '20/08/2026',
                items: [...state.currentCart],
                total,
                method: state.paymentMethod,
                status: state.paymentMode === 'paid' ? 'Paid' : 'Debt',
                customer: state.paymentMode === 'debt' ? document.getElementById('invoice-customer-select').value : 'Cash'
            };

            state.invoices.unshift(invoice);
            state.currentCart = [];
            renderAll();
        }

        function renderBestSellers() {
            const container = document.getElementById('best-sellers-list');
            container.innerHTML = '';
            state.medicines.slice(0, 5).forEach(m => {
                container.innerHTML += `
                    <div onclick="addToCart('${m.name}')" class="p-3 bg-gray-50 hover:bg-emerald-50 border rounded-xl cursor-pointer text-center w-32">
                        <h4 class="font-semibold text-sm truncate">${m.name}</h4>
                        <span class="text-xs text-emerald-600">${m.sell} MRU</span>
                    </div>
                `;
            });
        }

        function renderDebts() {
            const list = document.getElementById('due-debts-list');
            list.innerHTML = '';
            const debtInvoices = state.invoices.filter(i => i.status === 'Debt');
            if(debtInvoices.length === 0) {
                list.innerHTML = `<p class="text-sm text-gray-400">No due debts</p>`;
                return;
            }
            debtInvoices.forEach(inv => {
                list.innerHTML += `
                    <div class="flex justify-between items-center py-2">
                        <div>
                            <h4 class="font-semibold text-sm">${inv.customer}</h4>
                            <span class="text-xs text-gray-500">Invoice: ${inv.id}</span>
                        </div>
                        <span class="font-bold text-amber-600">${inv.total} MRU</span>
                    </div>
                `;
            });

            let totalLiabilities = state.suppliers.reduce((sum, s) => sum + s.amount, 0);
            document.getElementById('pharmacy-liabilities-display').innerText = totalLiabilities + ' MRU';
        }

        function renderCustomers() {
            const tbody = document.getElementById('customers-table-body');
            tbody.innerHTML = '';
            state.customers.forEach(c => {
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50">
                        <td class="p-4 font-medium">${c.name}</td>
                        <td class="p-4 text-gray-500">${c.phone}</td>
                        <td class="p-4 font-bold text-amber-600">${c.debt} MRU</td>
                        <td class="p-4"><span class="px-2 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs">Active</span></td>
                    </tr>
                `;
            });
        }

        function renderDailyReport() {
            const tbody = document.getElementById('daily-invoices-body');
            tbody.innerHTML = '';
            let totalRev = 0, cash = 0, bank = 0, debt = 0;

            state.invoices.forEach(inv => {
                totalRev += inv.total;
                if(inv.method === 'Cash') cash += inv.total;
                else bank += inv.total;
                if(inv.status === 'Debt') debt += inv.total;

                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50">
                        <td class="p-4 font-semibold">${inv.id}</td>
                        <td class="p-4 text-gray-500">${inv.time}</td>
                        <td class="p-4">${inv.method}</td>
                        <td class="p-4 font-bold text-emerald-600">${inv.total} MRU</td>
                        <td class="p-4"><span class="px-2 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs">${inv.status}</span></td>
                        <td class="p-4 text-center">
                            <button onclick="viewInvoice('${inv.id}')" class="text-emerald-600 hover:text-emerald-800"><i class="fa-solid fa-eye"></i></button>
                        </td>
                    </tr>
                `;
            });

            document.getElementById('daily-total-rev').innerText = totalRev + ' MRU';
            document.getElementById('daily-cash').innerText = cash + ' MRU';
            document.getElementById('daily-bank').innerText = bank + ' MRU';
            document.getElementById('daily-debt').innerText = debt + ' MRU';
        }

        function viewInvoice(id) {
            const inv = state.invoices.find(i => i.id === id);
            if(!inv) return;
            document.getElementById('print-inv-num').innerText = inv.id;
            document.getElementById('print-inv-date').innerText = `${inv.date} ${inv.time}`;
            document.getElementById('print-inv-method').innerText = inv.method;
            document.getElementById('print-inv-status').innerText = inv.status;
            document.getElementById('print-inv-total').innerText = inv.total + ' MRU';

            const tbody = document.getElementById('print-inv-items');
            tbody.innerHTML = '';
            inv.items.forEach(item => {
                tbody.innerHTML += `
                    <tr class="border-b border-gray-50">
                        <td class="py-2">${item.name}</td>
                        <td class="py-2">${item.qty}</td>
                        <td class="py-2">${item.price} MRU</td>
                        <td class="py-2 text-right">${item.price * item.qty} MRU</td>
                    </tr>
                `;
            });
            openModal('invoice-modal');
        }

        function downloadPDFInvoice() {
            html2pdf().from(document.getElementById('printable-invoice')).save('invoice.pdf');
        }

        function downloadPDFReport() {
            html2pdf().from(document.getElementById('tab-daily')).save('daily-report.pdf');
        }

        function updateStats() {
            document.getElementById('stat-sales-today').innerText = state.invoices.length;
            document.getElementById('stat-low-stock').innerText = state.medicines.filter(m => m.qty <= m.alert).length;
            document.getElementById('stat-near-expiry').innerText = state.medicines.filter(m => new Date(m.expiry) < new Date(Date.now() + 30*24*60*60*1000)).length;
            document.getElementById('stat-due-debts').innerText = state.invoices.filter(i => i.status === 'Debt').length;
        }

        function renderAll() {
            updateStats();
            renderInventory();
            renderSuppliers();
            renderBestSellers();
            renderCart();
            renderDebts();
            renderCustomers();
            renderDailyReport();
        }

        window.onload = init;
    </script>
</body>
</html>
