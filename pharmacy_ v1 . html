
<!DOCTYPE html>
<html lang="ar" dir="rtl" id="htmlRoot">
<head>
    <meta charset="UTF-8"> 
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="pageTitle">النظام الذكي لإدارة العيادات الطبية</title>
    <!-- Tailwind CSS للتصميم الراقي -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome للأيقونات الزاهية -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- خط عربي وأجنبي أنيق -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 to-teal-50 min-h-screen text-gray-800">

    <!-- الشريط العلوي -->
    <header class="bg-gradient-to-r from-teal-600 to-blue-600 text-white shadow-lg sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3 space-x-reverse">
                <div class="bg-white text-teal-600 p-2 rounded-xl shadow-md">
                    <i class="fa-solid fa-hospital-user text-2xl"></i>
                </div>
                <div>
                    <h1 id="brandName" class="text-xl font-bold">عيادة الشفاء الذكية</h1>
                    <p id="brandSub" class="text-xs text-teal-100">نظام الإدارة الشامل - يعمل بدون إنترنت (Offline)</p>
                </div>
            </div>
            <div class="flex items-center space-x-3 space-x-reverse">
                <!-- زر تبديل اللغة -->
                <button onclick="toggleLanguage()" class="bg-white/20 hover:bg-white/30 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1">
                    <i class="fa-solid fa-globe"></i> <span id="langBtnText">Français</span>
                </button>
                <span class="bg-teal-700 px-3 py-1 rounded-full text-xs font-semibold shadow-inner hidden sm:inline-block">
                    <i class="fa-solid fa-circle text-green-400 text-[8px] ml-1"></i> <span id="offlineBadge">وضع غير متصل</span>
                </span>
            </div>
        </div>
    </header>

    <!-- المحتوى الرئيسي -->
    <main class="container mx-auto px-4 py-6 max-w-7xl">
        
        <!-- أزرار التنقل الرئيسية (Tabs) -->
        <div class="grid grid-cols-2 md:grid-cols-6 gap-3 mb-6">
            <button onclick="switchTab('dashboard')" id="btn-dashboard" class="tab-btn bg-teal-600 text-white p-3 rounded-2xl shadow-md flex items-center justify-center space-x-2 space-x-reverse transition hover:bg-teal-700 font-bold text-sm">
                <i class="fa-solid fa-chart-pie ml-1"></i> <span data-i18n="nav_dashboard">لوحة القيادة</span>
            </button>
            <button onclick="switchTab('patients')" id="btn-patients" class="tab-btn bg-white text-gray-700 p-3 rounded-2xl shadow-md flex items-center justify-center space-x-2 space-x-reverse transition hover:bg-teal-50 font-bold text-sm">
                <i class="fa-solid fa-users ml-1 text-teal-600"></i> <span data-i18n="nav_patients">إدارة المرضى</span>
            </button>
            <button onclick="switchTab('appointments')" id="btn-appointments" class="tab-btn bg-white text-gray-700 p-3 rounded-2xl shadow-md flex items-center justify-center space-x-2 space-x-reverse transition hover:bg-teal-50 font-bold text-sm">
                <i class="fa-solid fa-calendar-check ml-1 text-blue-600"></i> <span data-i18n="nav_appointments">المواعيد</span>
            </button>
            <button onclick="switchTab('prescriptions')" id="btn-prescriptions" class="tab-btn bg-white text-gray-700 p-3 rounded-2xl shadow-md flex items-center justify-center space-x-2 space-x-reverse transition hover:bg-teal-50 font-bold text-sm">
                <i class="fa-solid fa-file-prescription ml-1 text-indigo-600"></i> <span data-i18n="nav_prescriptions">الوصفات الطبية</span>
            </button>
            <button onclick="switchTab('finances')" id="btn-finances" class="tab-btn bg-white text-gray-700 p-3 rounded-2xl shadow-md flex items-center justify-center space-x-2 space-x-reverse transition hover:bg-teal-50 font-bold text-sm">
                <i class="fa-solid fa-wallet ml-1 text-emerald-600"></i> <span data-i18n="nav_finances">الحسابات المالية</span>
            </button>
            <button onclick="switchTab('reports')" id="btn-reports" class="tab-btn bg-white text-gray-700 p-3 rounded-2xl shadow-md flex items-center justify-center space-x-2 space-x-reverse transition hover:bg-teal-50 font-bold text-sm">
                <i class="fa-solid fa-chart-line ml-1 text-amber-600"></i> <span data-i18n="nav_reports">تقارير المرضى</span>
            </button>
        </div>

        <!-- 1. لوحة القيادة -->
        <div id="dashboard" class="tab-content active space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-white p-5 rounded-2xl shadow-lg border-r-4 border-teal-500 flex items-center justify-between">
                    <div>
                        <p class="text-gray-500 text-xs font-semibold" data-i18n="stat_patients">إجمالي المرضى</p>
                        <h3 id="stat-patients" class="text-2xl font-bold text-gray-800 mt-1">0</h3>
                    </div>
                    <div class="bg-teal-100 text-teal-600 p-3 rounded-xl"><i class="fa-solid fa-user-injured text-xl"></i></div>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-lg border-r-4 border-blue-500 flex items-center justify-between">
                    <div>
                        <p class="text-gray-500 text-xs font-semibold" data-i18n="stat_appointments">مواعيد اليوم</p>
                        <h3 id="stat-appointments" class="text-2xl font-bold text-gray-800 mt-1">0</h3>
                    </div>
                    <div class="bg-blue-100 text-blue-600 p-3 rounded-xl"><i class="fa-solid fa-calendar-day text-xl"></i></div>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-lg border-r-4 border-indigo-500 flex items-center justify-between">
                    <div>
                        <p class="text-gray-500 text-xs font-semibold" data-i18n="stat_prescriptions">الوصفات الطبية</p>
                        <h3 id="stat-prescriptions" class="text-2xl font-bold text-gray-800 mt-1">0</h3>
                    </div>
                    <div class="bg-indigo-100 text-indigo-600 p-3 rounded-xl"><i class="fa-solid fa-prescription text-xl"></i></div>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-lg border-r-4 border-emerald-500 flex items-center justify-between">
                    <div>
                        <p class="text-gray-500 text-xs font-semibold" data-i18n="stat_revenue">إجمالي الإيرادات</p>
                        <h3 id="stat-revenue" class="text-2xl font-bold text-emerald-600 mt-1">0 MRU</h3>
                    </div>
                    <div class="bg-emerald-100 text-emerald-600 p-3 rounded-xl"><i class="fa-solid fa-money-bill-wave text-xl"></i></div>
                </div>
            </div>
            
            <div class="bg-white p-6 rounded-2xl shadow-lg">
                <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-bolt text-amber-500 ml-2"></i> <span data-i18n="quick_actions">إجراءات سريعة</span></h3>
                <div class="flex flex-wrap gap-4">
                    <button onclick="switchTab('patients')" class="bg-teal-600 text-white px-4 py-2.5 rounded-xl shadow hover:bg-teal-700 transition font-semibold text-sm"><i class="fa-solid fa-user-plus ml-2"></i> <span data-i18n="btn_add_patient">تسجيل مريض جديد</span></button>
                    <button onclick="switchTab('appointments')" class="bg-blue-600 text-white px-4 py-2.5 rounded-xl shadow hover:bg-blue-700 transition font-semibold text-sm"><i class="fa-solid fa-calendar-plus ml-2"></i> <span data-i18n="btn_add_appointment">حجز موعد جديد</span></button>
                    <button onclick="switchTab('finances')" class="bg-emerald-600 text-white px-4 py-2.5 rounded-xl shadow hover:bg-emerald-700 transition font-semibold text-sm"><i class="fa-solid fa-cash-register ml-2"></i> <span data-i18n="btn_add_revenue">تسجيل دفعة مالية</span></button>
                </div>
            </div>
        </div>

        <!-- 2. إدارة المرضى -->
        <div id="patients" class="tab-content space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-lg">
                <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-user-plus text-teal-600 ml-2"></i> <span data-i18n="title_add_patient">إضافة مريض جديد</span></h3>
                <form id="patientForm" onsubmit="addPatient(event)" class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <input type="text" id="pName" placeholder="اسم المريض الكامل" required class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-teal-500 outline-none">
                    <input type="tel" id="pPhone" placeholder="رقم الهاتف" required class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-teal-500 outline-none">
                    <input type="number" id="pAge" placeholder="العمر" required class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-teal-500 outline-none">
                    <input type="text" id="pCondition" placeholder="الحالة الصحية أو المرض المزمن" class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-teal-500 outline-none">
                    <button type="submit" class="md:col-span-4 bg-teal-600 text-white py-3 rounded-xl shadow hover:bg-teal-700 transition font-bold"><i class="fa-solid fa-save ml-2"></i> <span data-i18n="btn_save_patient">حفظ بيانات المريض</span></button>
                </form>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-lg">
                <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-list text-teal-600 ml-2"></i> <span data-i18n="title_patients_list">قائمة المرضى المسجلين</span></h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-right border-collapse">
                        <thead>
                            <tr class="bg-teal-50 text-teal-800 border-b">
                                <th class="p-3 rounded-r-xl" data-i18n="th_name">الاسم</th>
                                <th class="p-3" data-i18n="th_phone">الهاتف</th>
                                <th class="p-3" data-i18n="th_age">العمر</th>
                                <th class="p-3" data-i18n="th_condition">الحالة الصحية</th>
                                <th class="p-3 rounded-l-xl" data-i18n="th_actions">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="patientsTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 3. المواعيد -->
        <div id="appointments" class="tab-content space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-lg">
                <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-calendar-plus text-blue-600 ml-2"></i> <span data-i18n="title_add_appointment">حجز موعد جديد</span></h3>
                <form id="appointmentForm" onsubmit="addAppointment(event)" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <input type="text" id="aPatientName" placeholder="اسم المريض" required class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none">
                    <input type="date" id="aDate" required class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none">
                    <input type="time" id="aTime" required class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none">
                    <button type="submit" class="md:col-span-3 bg-blue-600 text-white py-3 rounded-xl shadow hover:bg-blue-700 transition font-bold"><i class="fa-solid fa-check ml-2"></i> <span data-i18n="btn_confirm_appointment">تأكيد الموعد</span></button>
                </form>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-lg">
                <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-clock text-blue-600 ml-2"></i> <span data-i18n="title_appointments_list">جدول المواعيد المحجوزة</span></h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-right border-collapse">
                        <thead>
                            <tr class="bg-blue-50 text-blue-800 border-b">
                                <th class="p-3 rounded-r-xl" data-i18n="th_patient_name">اسم المريض</th>
                                <th class="p-3" data-i18n="th_date">التاريخ</th>
                                <th class="p-3" data-i18n="th_time">الوقت</th>
                                <th class="p-3 rounded-l-xl" data-i18n="th_actions">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="appointmentsTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 4. الوصفات الطبية -->
        <div id="prescriptions" class="tab-content space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-lg">
                <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-pen-nib text-indigo-600 ml-2"></i> <span data-i18n="title_add_prescription">إنشاء وصفة طبية</span></h3>
                <form id="prescriptionForm" onsubmit="addPrescription(event)" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <input type="text" id="rxPatient" placeholder="اسم المريض" required class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                    <input type="text" id="rxDiagnosis" placeholder="التشخيص الطبي" required class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                    <textarea id="rxMedicines" placeholder="الأدوية والجرعات المطلوبة..." rows="3" required class="md:col-span-2 border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none"></textarea>
                    <button type="submit" class="md:col-span-2 bg-indigo-600 text-white py-3 rounded-xl shadow hover:bg-indigo-700 transition font-bold"><i class="fa-solid fa-print ml-2"></i> <span data-i18n="btn_save_prescription">حفظ وإصدار الوصفة</span></button>
                </form>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-lg">
                <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-folder-open text-indigo-600 ml-2"></i> <span data-i18n="title_prescriptions_archive">أرشيف الوصفات الطبية</span></h3>
                <div id="prescriptionsList" class="space-y-4"></div>
            </div>
        </div>

        <!-- 5. الحسابات المالية -->
        <div id="finances" class="tab-content space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-lg">
                <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-cash-register text-emerald-600 ml-2"></i> <span data-i18n="title_add_transaction">تسجيل إيراد أو دفعة كشف</span></h3>
                <form id="financeForm" onsubmit="addTransaction(event)" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <input type="text" id="fPatient" placeholder="اسم المريض / مصدر الدخل" required class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-emerald-500 outline-none">
                    <input type="number" id="fAmount" placeholder="المبلغ (MRU)" required class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-emerald-500 outline-none">
                    <select id="fType" class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-emerald-500 outline-none">
                        <option value="كشف طبى" data-i18n="opt_consultation">كشف طبي</option>
                        <option value="استشارة" data-i18n="opt_checkup">استشارة / متابعة</option>
                        <option value="خدمة أخرى" data-i18n="opt_other">خدمة أخرى</option>
                    </select>
                    <button type="submit" class="md:col-span-3 bg-emerald-600 text-white py-3 rounded-xl shadow hover:bg-emerald-700 transition font-bold"><i class="fa-solid fa-plus-circle ml-2"></i> <span data-i18n="btn_save_transaction">حفظ المعاملة المالية</span></button>
                </form>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-lg">
                <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-file-invoice-dollar text-emerald-600 ml-2"></i> <span data-i18n="title_transactions_list">سجل المعاملات المالية والإيرادات</span></h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-right border-collapse">
                        <thead>
                            <tr class="bg-emerald-50 text-emerald-800 border-b">
                                <th class="p-3 rounded-r-xl" data-i18n="th_payer">المريض / الدافع</th>
                                <th class="p-3" data-i18n="th_amount">المبلغ</th>
                                <th class="p-3" data-i18n="th_type">نوع الخدمة</th>
                                <th class="p-3" data-i18n="th_date">التاريخ</th>
                                <th class="p-3 rounded-l-xl" data-i18n="th_actions">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="financesTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 6. تقارير المرضى -->
        <div id="reports" class="tab-content space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-lg">
                <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-chart-line text-amber-600 ml-2"></i> <span data-i18n="title_patient_reports">التقارير الطبية الشاملة للمرضى</span></h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <select id="reportPatientSelect" onchange="generatePatientReport()" class="border border-gray-300 p-3 rounded-xl focus:ring-2 focus:ring-amber-500 outline-none">
                        <option value="" data-i18n="select_patient_prompt">-- اختر مريضاً لعرض تقريره الطبي المفصل --</option>
                    </select>
                </div>
                <div id="patientReportCard" class="bg-amber-50/50 border border-amber-100 p-6 rounded-2xl hidden space-y-4">
                    <div class="flex justify-between items-center border-b pb-3">
                        <h4 id="repName" class="font-bold text-lg text-amber-900"></h4>
                        <span id="repPhone" class="text-sm text-gray-600"></span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                        <p><strong>العمر:</strong> <span id="repAge"></span></p>
                        <p><strong>الحالة الصحية:</strong> <span id="repCondition"></span></p>
                    </div>
                    <div>
                        <h5 class="font-bold text-gray-700 mb-2 mt-4"><i class="fa-solid fa-file-prescription text-indigo-600 ml-1"></i> وصفات المريض الطبية السابقة:</h5>
                        <div id="repPrescriptions" class="space-y-2"></div>
                    </div>
                </div>
            </div>
        </div>

    </main>

