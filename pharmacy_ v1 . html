                btn_add_patient: "Nouveau Patient",
                btn_add_appointment: "Nouveau Rendez-vous",
                btn_add_revenue: "Enregistrer Paiement",
                title_add_patient: "Ajouter un Nouveau Patient",
                btn_save_patient: "Enregistrer le Patient",
                title_patients_list: "Liste des Patients Enregistrés",
                th_name: "Nom",
                th_phone: "Téléphone",
                th_age: "Âge",
                th_condition: "État de Santé",
                th_actions: "Actions",
                title_add_appointment: "Planifier un Rendez-vous",
                btn_confirm_appointment: "Confirmer",
                title_appointments_list: "Calendrier des Rendez-vous",
                th_patient_name: "Nom du Patient",
                th_date: "Date",
                th_time: "Heure",
                title_add_prescription: "Créer une Ordonnance",
                btn_save_prescription: "Sauvegarder et Éditer",
                title_prescriptions_archive: "Archive des Ordonnances",
                title_add_transaction: "Enregistrer une Transaction",
                opt_consultation: "Consultation",
                opt_checkup: "Suivi / Contrôle",
                opt_other: "Autre Service",
                btn_save_transaction: "Enregistrer",
                title_transactions_list: "Historique Financier",
                th_payer: "Payeur / Patient",
                th_amount: "Montant",
                th_type: "Type",
                title_patient_reports: "Rapports Médicaux Détaillés",
                select_patient_prompt: "-- Sélectionner un patient pour voir son rapport --"
            }
        };

        let currentLang = localStorage.getItem('clinic_lang') || 'ar';

        function toggleLanguage() {
            currentLang = currentLang === 'ar' ? 'fr' : 'ar';
            localStorage.setItem('clinic_lang', currentLang);
            applyLanguage();
        }

        function applyLanguage() {
            const root = document.getElementById('htmlRoot');
            root.setAttribute('dir', currentLang === 'ar' ? 'rtl' : 'ltr');
            root.setAttribute('lang', currentLang);

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[currentLang][key]) {
                    el.innerText = translations[currentLang][key];
                }
            });

            document.getElementById('langBtnText').innerText = translations[currentLang].langBtnText;
            document.getElementById('brandName').innerText = translations[currentLang].brandName;
            document.getElementById('brandSub').innerText = translations[currentLang].brandSub;
            document.getElementById('pageTitle').innerText = translations[currentLang].pageTitle;
            document.getElementById('offlineBadge').innerText = translations[currentLang].offlineBadge;
        }

        let patients = JSON.parse(localStorage.getItem('clinic_patients')) || [];
        let appointments = JSON.parse(localStorage.getItem('clinic_appointments')) || [];
        let prescriptions = JSON.parse(localStorage.getItem('clinic_prescriptions')) || [];
        let finances = JSON.parse(localStorage.getItem('clinic_finances')) || [];

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('bg-teal-600', 'text-white');
                el.classList.add('bg-white', 'text-gray-700');
            });
            
            document.getElementById(tabId).classList.add('active');
            let activeBtn = document.getElementById('btn-' + tabId);
            activeBtn.classList.remove('bg-white', 'text-gray-700');
            activeBtn.classList.add('bg-teal-600', 'text-white');
            updateStats();
        }

        function saveData() {
            localStorage.setItem('clinic_patients', JSON.stringify(patients));
            localStorage.setItem('clinic_appointments', JSON.stringify(appointments));
            localStorage.setItem('clinic_prescriptions', JSON.stringify(prescriptions));
            localStorage.setItem('clinic_finances', JSON.stringify(finances));
            updateStats();
        }

        function updateStats() {
            document.getElementById('stat-patients').innerText = patients.length;
            document.getElementById('stat-appointments').innerText = appointments.length;
            document.getElementById('stat-prescriptions').innerText = prescriptions.length;
            
            const totalRev = finances.reduce((sum, item) => sum + Number(item.amount), 0);
            document.getElementById('stat-revenue').innerText = totalRev + ' MRU';
            
            renderTables();
            updateReportDropdown();
        }

        function addPatient(e) {
            e.preventDefault();
            const name = document.getElementById('pName').value;
            const phone = document.getElementById('pPhone').value;
            const age = document.getElementById('pAge').value;
            const condition = document.getElementById('pCondition').value || 'سليم / عاد';
            
            patients.push({ id: Date.now(), name, phone, age, condition });
            saveData();
            document.getElementById('patientForm').reset();
            alert(currentLang === 'ar' ? 'تمت إضافة المريض بنجاح!' : 'Patient ajouté avec succès !');
        }

        function deletePatient(id) {
            patients = patients.filter(p => p.id !== id);
            saveData();
        }

        function addAppointment(e) {
            e.preventDefault();
            const patientName = document.getElementById('aPatientName').value;
            const date = document.getElementById('aDate').value;
            const time = document.getElementById('aTime').value;

            appointments.push({ id: Date.now(), patientName, date, time });
            saveData();
            document.getElementById('appointmentForm').reset();
            alert(currentLang === 'ar' ? 'تم حجز الموعد بنجاح!' : 'Rendez-vous planifié !');
        }

        function deleteAppointment(id) {
            appointments = appointments.filter(a => a.id !== id);
            saveData();
        }

        function addPrescription(e) {
            e.preventDefault();
            const patient = document.getElementById('rxPatient').value;
            const diagnosis = document.getElementById('rxDiagnosis').value;
            const medicines = document.getElementById('rxMedicines').value;

            prescriptions.push({ id: Date.now(), patient, diagnosis, medicines, date: new Date().toLocaleDateString() });
            saveData();
            document.getElementById('prescriptionForm').reset();
            alert(currentLang === 'ar' ? 'تم إصدار الوصفة الطبية بنجاح!' : 'Ordonnance émise !');
        }

        function addTransaction(e) {
            e.preventDefault();
            const payer = document.getElementById('fPatient').value;
            const amount = document.getElementById('fAmount').value;
            const type = document.getElementById('fType').value;

            finances.push({ id: Date.now(), payer, amount, type, date: new Date().toLocaleDateString() });
            saveData();
            document.getElementById('financeForm').reset();
            alert(currentLang === 'ar' ? 'تم تسجيل المعاملة المالية بنجاح!' : 'Transaction enregistrée !');
        }

        function deleteTransaction(id) {
            finances = finances.filter(f => f.id !== id);
            saveData();
        }

        function updateReportDropdown() {
            const select = document.getElementById('reportPatientSelect');
            select.innerHTML = `<option value="">${translations[currentLang].select_patient_prompt}</option>` + 
                patients.map(p => `<option value="${p.name}">${p.name} (${p.phone})</option>`).join('');
        }

        function generatePatientReport() {
            const name = document.getElementById('reportPatientSelect').value;
            const card = document.getElementById('patientReportCard');
            if(!name) {
                card.classList.add('hidden');
                return;
            }

            const patient = patients.find(p => p.name === name);
            const patientRx = prescriptions.filter(rx => rx.patient === name);

            document.getElementById('repName').innerText = patient.name;
            document.getElementById('repPhone').innerText = '📞 ' + patient.phone;
            document.getElementById('repAge').innerText = patient.age + (currentLang === 'ar' ? ' سنة' : ' ans');
            document.getElementById('repCondition').innerText = patient.condition;

            const rxContainer = document.getElementById('repPrescriptions');
            rxContainer.innerHTML = patientRx.length ? patientRx.map(rx => `
                <div class="bg-white p-3 rounded-lg border text-xs">
                    <span class="font-bold text-indigo-800">${rx.date} - التشخيص: ${rx.diagnosis}</span>
                    <p class="text-gray-600 mt-1">الأدوية: ${rx.medicines}</p>
                </div>
            `).join('') : `<p class="text-xs text-gray-400">لا توجد وصفات مسجلة لهذا المريض.</p>`;

            card.classList.remove('hidden');
        }

        function renderTables() {
            document.getElementById('patientsTableBody').innerHTML = patients.map(p => `
                <tr class="border-b hover:bg-gray-50 text-sm">
                    <td class="p-3 font-semibold">${p.name}</td>
                    <td class="p-3">${p.phone}</td>
                    <td class="p-3">${p.age}</td>
                    <td class="p-3 text-teal-700 font-medium">${p.condition}</td>
                    <td class="p-3">
                        <button onclick="deletePatient(${p.id})" class="bg-red-100 text-red-600 px-3 py-1 rounded-lg text-xs font-bold hover:bg-red-200 transition"><i class="fa-solid fa-trash ml-1"></i> حذف</button>
                    </td>
                </tr>
            `).join('') || `<tr><td colspan="5" class="p-4 text-center text-gray-400">لا توجد بيانات مسجلة بعد</td></tr>`;

            document.getElementById('appointmentsTableBody').innerHTML = appointments.map(a => `
                <tr class="border-b hover:bg-gray-50 text-sm">
                    <td class="p-3 font-semibold">${a.patientName}</td>
                    <td class="p-3">${a.date}</td>
                    <td class="p-3">${a.time}</td>
                    <td class="p-3">
                        <button onclick="deleteAppointment(${a.id})" class="bg-red-100 text-red-600 px-3 py-1 rounded-lg text-xs font-bold hover:bg-red-200 transition"><i class="fa-solid fa-trash ml-1"></i> إلغاء</button>
                    </td>
                </tr>
            `).join('') || `<tr><td colspan="4" class="p-4 text-center text-gray-400">لا توجد مواعيد محجوزة</td></tr>`;

            document.getElementById('prescriptionsList').innerHTML = prescriptions.map(rx => `
                <div class="border border-indigo-100 bg-indigo-50/50 p-4 rounded-xl relative">
                    <div class="flex justify-between items-center mb-2">
                        <h4 class="font-bold text-indigo-900"><i class="fa-solid fa-user-doctor ml-1"></i> ${rx.patient}</h4>
                        <span class="text-xs text-gray-500">${rx.date}</span>
                    </div>
                    <p class="text-sm text-gray-700 mb-1"><strong>التشخيص:</strong> ${rx.diagnosis}</p>
                    <p class="text-sm text-gray-700 bg-white p-3 rounded-lg border"><strong>الأدوية:</strong> ${rx.medicines}</p>
                </div>
            `).join('') || `<p class="text-center text-gray-400 text-sm">لا توجد وصفات طبية مسجلة</p>`;

            document.getElementById('financesTableBody').innerHTML = finances.map(f => `
                <tr class="border-b hover:bg-gray-50 text-sm">
                    <td class="p-3 font-semibold">${f.payer}</td>
                    <td class="p-3 text-emerald-600 font-bold">${f.amount} MRU</td>
                    <td class="p-3"><span class="bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-md text-xs font-semibold">${f.type}</span></td>
                    <td class="p-3 text-gray-500">${f.date}</td>
                    <td class="p-3">
                        <button onclick="deleteTransaction(${f.id})" class="bg-red-100 text-red-600 px-3 py-1 rounded-lg text-xs font-bold hover:bg-red-200 transition"><i class="fa-solid fa-trash ml-1"></i> حذف</button>
                    </td>
                </tr>
            `).join('') || `<tr><td colspan="5" class="p-4 text-center text-gray-400">لا توجد معاملات مالية مسجلة</td></tr>`;
        }

        applyLanguage();
        updateStats();
    </script>
</body>
</html>

